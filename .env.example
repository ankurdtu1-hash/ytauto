# Copy this file to .env and fill in the keys.

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# https://pixabay.com/api/docs/ (free, log in to see your key)
PIXABAY_API_KEY=

CHANNEL_NAME=TechSeekho AI
CHANNEL_NICHE=Hindi facts and explainers about AI, technology, gadgets, the internet and science, for curious Indian viewers

# hi-IN-MadhurNeural (male) or hi-IN-SwaraNeural (female)
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+8%

# Keep "private" until Google approves the YouTube API audit, then set to "public".
UPLOAD_PRIVACY=private

# YouTube category: 27 = Education, 28 = Science & Technology
YOUTUBE_CATEGORY_ID=27
